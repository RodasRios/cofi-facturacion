# Copia este archivo como .env EN LA RAÍZ del repo (junto a docker-compose.yml)
# antes de levantar el proyecto en el servidor. No lo subas a git.

# Genera una clave real con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-en-produccion

DEBUG=False

# Dominios desde los que se sirve la app (separados por comas, sin https://)
ALLOWED_HOSTS=facturacion.cofilatam.com

# Frontend y API van por el mismo origen detrás de nginx, así que CORS_ALLOWED_ORIGINS
# normalmente puede quedar vacío.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://facturacion.cofilatam.com

DB_NAME=facturacion
DB_USER=facturacion_user
# Genera una contraseña real con: openssl rand -hex 24
DB_PASSWORD=cambia-esta-contrasena

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Contraseña del usuario 'admin' que crea seed.py en el primer arranque.
ADMIN_PASSWORD=cambia-esta-contrasena-tambien

# Tras el primer arranque, pon esto en false para no reinsertar las plantas
# y materiales de ejemplo.
RUN_SEED=true

# Último número de cotización emitido FUERA del sistema. Las cotizaciones del
# sistema siguen desde ahí con el formato de la empresa: con 159, la primera
# sale "COT: 160-2.026". Se reinicia la cuenta cada año.
COTIZACION_CONSECUTIVO_INICIAL=0
